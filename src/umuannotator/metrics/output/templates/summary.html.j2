<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f7f9;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #e5e7eb;
      --header: #f9fafb;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111827;
        --card: #1f2937;
        --text: #f9fafb;
        --muted: #9ca3af;
        --border: #374151;
        --header: #111827;
      }
    }

    body {
      margin: 0;
      padding: 2rem;
      background: var(--bg);
      color: var(--text);
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      line-height: 1.45;
    }

    h1,
    h2 {
      margin-top: 0;
    }

    .header,
    .card {
      max-width: 1400px;
      margin: 0 auto 1.5rem auto;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .overview {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .stat {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.75rem;
      background: var(--card);
    }

    .stat .label {
      color: var(--muted);
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
    }

    .stat .value {
      font-size: 1.4rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    th,
    td {
      border-bottom: 1px solid var(--border);
      padding: 0.55rem 0.65rem;
      vertical-align: top;
      text-align: left;
    }

    th {
      background: var(--header);
      color: var(--muted);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    tr:hover td {
      background: rgba(127, 127, 127, 0.06);
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .muted {
      color: var(--muted);
    }

    .empty {
      color: var(--muted);
    }
  </style>
</head>
<body>
  <section class="header">
    <h1>{{ title }}</h1>
  </section>

  {% if overview %}
    <section class="card">
      <h2>Overview</h2>

      <div class="overview">
        {% for item in overview %}
          <div class="stat">
            <div class="label">{{ item.label }}</div>
            <div class="value">{{ item.value }}</div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% for section in sections %}
    <section class="card">
      <h2>{{ section.title }}</h2>

      {% if not section.rows %}
        <p class="empty">No rows.</p>
      {% else %}
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                {% for field in section.fields %}
                  <th>{{ field }}</th>
                {% endfor %}
              </tr>
            </thead>

            <tbody>
              {% for row in section.rows %}
                <tr>
                  {% for field in section.fields %}
                    {% set value = row.get(field, "") %}
                    <td class="{% if value is number %}num{% endif %}">
                      {{ value }}
                    </td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>
  {% endfor %}
</body>
</html>